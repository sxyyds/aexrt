#version 460
/* AEXRT-M int8 elementwise, position-major, four channels per invocation.
 * The W8A8 plan unifies activation scales across concat/add/pool boundaries,
 * so maxpool is an int8 max, resize is an int8 copy and add is a clamped
 * int8 sum - no rescale pass is needed.  Channels are packed four per uint,
 * avoiding any dependency on 8-bit storage support.
 *   1 maxpool | 2 nearest resize | 3 add
 */
layout(local_size_x = 128) in;
layout(set = 0, binding = 0) readonly buffer InA { uint a[]; };
layout(set = 0, binding = 1) readonly buffer InB { uint b[]; };
layout(set = 0, binding = 2) writeonly buffer Out { uint o[]; };
layout(push_constant) uniform PC {
    uint op; uint elems;
    uint in_h; uint in_w; uint out_h; uint out_w;
    uint in_c; uint out_c;
    uint in0_off; uint in1_off; uint out_off;
    uint in0_ctot; uint in1_ctot; uint out_ctot;
    uint kh; uint kw; uint sh; uint sw; uint ph; uint pw;
    uint scale;
} pc;

int s8(uint v, uint shift) {
    int x = int((v >> shift) & 255u);
    return x >= 128 ? x - 256 : x;
}
uint p8(int a, int b, int c, int d) {
    return (uint(a) & 255u) | ((uint(b) & 255u) << 8) |
           ((uint(c) & 255u) << 16) | ((uint(d) & 255u) << 24);
}
uint pack_vec4(int q[4]) {
    return p8(q[0], q[1], q[2], q[3]);
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.elems) return;
    uint cg = pc.out_c >> 2;
    uint c4 = i % cg;
    uint pos = i / cg;
    uint obase = (pos * pc.out_ctot + pc.out_off) >> 2;

    if (pc.op == 3u) {   /* add, same unified scale */
        uint va = a[((pos * pc.in0_ctot + pc.in0_off) >> 2) + c4];
        uint vb = b[((pos * pc.in1_ctot + pc.in1_off) >> 2) + c4];
        int q[4];
        for (uint l = 0u; l < 4u; ++l) {
            int s = s8(va, l * 8u) + s8(vb, l * 8u);
            q[l] = clamp(s, -127, 127);
        }
        o[obase + c4] = pack_vec4(q);
        return;
    }
    uint oy = pos / pc.out_w;
    uint ox = pos - oy * pc.out_w;
    if (pc.op == 2u) {   /* nearest integer resize: identical bytes */
        uint iy = oy / pc.scale, ix = ox / pc.scale;
        uint idx = ((iy * pc.in_w + ix) * pc.in0_ctot + pc.in0_off) >> 2;
        o[obase + c4] = a[idx + c4];
        return;
    }
    /* op 1: int8 maxpool */
    int q[4] = {-128, -128, -128, -128};
    for (uint dy = 0u; dy < pc.kh; ++dy) {
        int sy = int(oy * pc.sh + dy) - int(pc.ph);
        if (sy < 0 || sy >= int(pc.in_h)) continue;
        for (uint dx = 0u; dx < pc.kw; ++dx) {
            int sx = int(ox * pc.sw + dx) - int(pc.pw);
            if (sx < 0 || sx >= int(pc.in_w)) continue;
            uint idx = ((uint(sy) * pc.in_w + uint(sx)) * pc.in0_ctot + pc.in0_off) >> 2;
            uint v = a[idx + c4];
            for (uint l = 0u; l < 4u; ++l) q[l] = max(q[l], s8(v, l * 8u));
        }
    }
    o[obase + c4] = pack_vec4(q);
}
