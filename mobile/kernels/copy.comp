#version 460
/* Plain copy for concat branches (pre-offset source via descriptor). */
layout(local_size_x = 128) in;
layout(set = 0, binding = 0) readonly buffer Src { float s[]; };
layout(set = 0, binding = 1) writeonly buffer Dst { float d[]; };
layout(push_constant) uniform PC { uint elems; } pc;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.elems) return;
    d[i] = s[i];
}
