#version 460
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
/* AEXRT-M conv fp16-dot, 1-OC/thread variant for 10x10 feature maps.
 *
 * At 10x10 a 64-OC layer with 8 OC/thread yields only 800 invocations
 * (7 workgroups) - most Mali cores sit idle.  One OC per thread gives
 * oc*spatial invocations (6400 for 64 OC), filling all cores; the fp16 dot
 * chain is unchanged and weight rows are shared through L1 across positions.
 * Used only when oh*ow <= 100; larger maps keep 4-OC / 8-OC blocking.
 */
layout(local_size_x = 128) in;
layout(set = 0, binding = 0) readonly buffer InBuf { f16vec4 in4[]; };
layout(set = 0, binding = 1) readonly buffer WBuf  { f16vec4 w4[]; };
layout(set = 0, binding = 2) readonly buffer BBuf  { float b_data[]; };
layout(set = 0, binding = 3) writeonly buffer OutBuf{ f16vec4 out4[]; };
layout(set = 0, binding = 4) readonly buffer InS   { float16_t in_s[]; };
layout(set = 0, binding = 5) readonly buffer WS    { float16_t w_s[]; };
layout(set = 0, binding = 6) writeonly buffer OutS { float16_t o_s[]; };

layout(push_constant) uniform PC {
    uint batch; uint in_c; uint in_h; uint in_w;
    uint out_c; uint out_h; uint out_w;
    uint kh; uint kw; uint sh; uint sw; uint ph; uint pw; uint silu;
    uint w_off; uint b_off; uint in_off; uint out_off;
    uint out_ctot; uint in_ctot;
} pc;

float16_t dot16(f16vec4 v0, f16vec4 v1, f16vec4 v2, f16vec4 v3,
                f16vec4 w0, f16vec4 w1, f16vec4 w2, f16vec4 w3) {
    return dot(v0, w0) + dot(v1, w1) + dot(v2, w2) + dot(v3, w3);
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint spatial = pc.out_h * pc.out_w;
    uint total = pc.batch * pc.out_c * spatial;
    if (idx >= total) return;
    uint pos = idx % spatial;
    uint t = idx / spatial;
    uint oc = t % pc.out_c;
    uint n = t / pc.out_c;
    uint oh = pos / pc.out_w;
    uint ow = pos - oh * pc.out_w;

    float acc = b_data[pc.b_off + oc];
    uint C = pc.in_c;
    uint C4 = C >> 2;
    uint R = C * pc.kh * pc.kw;
    uint row_v4 = ((R + 3u) & ~3u) >> 2;
    uint wbase = pc.w_off + oc * row_v4;
    uint groups = C4 >> 2;
    uint tail = C4 & 3u;

    for (uint kk = 0u; kk < pc.kh * pc.kw; ++kk) {
        uint ky = kk / pc.kw;
        uint kx = kk - ky * pc.kw;
        int ih = int(oh * pc.sh + ky) - int(pc.ph);
        int iw = int(ow * pc.sw + kx) - int(pc.pw);
        if (ih < 0 || ih >= int(pc.in_h) || iw < 0 || iw >= int(pc.in_w)) continue;
        uint ibase = ((uint(ih) * pc.in_w + uint(iw)) * pc.in_ctot + pc.in_off) >> 2;
        uint wrow = wbase + kk * C4;
        for (uint g = 0u; g < groups; ++g) {
            uint o = g * 4u;
            f16vec4 v0 = in4[ibase + o + 0u];
            f16vec4 v1 = in4[ibase + o + 1u];
            f16vec4 v2 = in4[ibase + o + 2u];
            f16vec4 v3 = in4[ibase + o + 3u];
            uint b0 = wrow + o;
            acc += float(dot16(v0, v1, v2, v3,
                               w4[b0], w4[b0 + 1u], w4[b0 + 2u], w4[b0 + 3u]));
        }
        for (uint o = groups * 4u; o < C4; ++o) {
            acc += float(dot(in4[ibase + o], w4[wrow + o]));
        }
    }

    if (pc.silu == 1u) {
        acc = acc / (1.0 + exp(-acc));
    } else if (pc.silu == 2u) {
        acc = 1.0 / (1.0 + exp(-acc));
    }
    o_s[pos * pc.out_ctot + pc.out_off + oc] = float16_t(acc);
}
