#version 460
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
/* AEXRT-M conv fp16-dot, 4-OC/thread variant for short spatial maps.
 *
 * Same position-major layout and 16-channel fp16 dot chain as conv_f16, but
 * each invocation owns one position x 4 output channels.  For 10x10 / 20x20
 * layers the 8-OC kernel only produces a handful of workgroups and leaves
 * most of the Mali cores idle; halving the per-thread OC block doubles the
 * thread count and therefore occupancy, at the cost of 2x input loads per
 * output (still shared through L1 across the OC quartets).
 * Selected by the runtime for oh*ow <= 400; autotune compares it per device.
 */
layout(local_size_x = 128) in;
layout(set = 0, binding = 0) readonly buffer InBuf { f16vec4 in4[]; };
layout(set = 0, binding = 1) readonly buffer WBuf  { f16vec4 w4[]; };
layout(set = 0, binding = 2) readonly buffer BBuf  { float b_data[]; };
layout(set = 0, binding = 3) writeonly buffer OutBuf{ f16vec4 out4[]; };
layout(set = 0, binding = 4) readonly buffer InS   { float16_t in_s[]; };
layout(set = 0, binding = 5) readonly buffer WS    { float16_t w_s[]; };
layout(set = 0, binding = 6) writeonly buffer OutS { float16_t o_s[]; };

layout(push_constant) uniform PC {
    uint batch; uint in_c; uint in_h; uint in_w;
    uint out_c; uint out_h; uint out_w;
    uint kh; uint kw; uint sh; uint sw; uint ph; uint pw; uint silu;
    uint w_off; uint b_off; uint in_off; uint out_off;
    uint out_ctot; uint in_ctot;
} pc;

float16_t dot16(f16vec4 v0, f16vec4 v1, f16vec4 v2, f16vec4 v3,
                f16vec4 w0, f16vec4 w1, f16vec4 w2, f16vec4 w3) {
    return dot(v0, w0) + dot(v1, w1) + dot(v2, w2) + dot(v3, w3);
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint spatial = pc.out_h * pc.out_w;
    uint oc4 = (pc.out_c + 3u) / 4u;
    uint total = pc.batch * oc4 * spatial;
    if (idx >= total) return;
    uint pos = idx % spatial;
    uint t = idx / spatial;
    uint oc4_idx = t % oc4;
    uint n = t / oc4;
    uint oh = pos / pc.out_w;
    uint ow = pos - oh * pc.out_w;
    uint oc0 = oc4_idx * 4u;

    vec4 acc = vec4(0.0);
    if (oc0 < pc.out_c)      acc.x = b_data[pc.b_off + oc0];
    if (oc0 + 1u < pc.out_c) acc.y = b_data[pc.b_off + oc0 + 1u];
    if (oc0 + 2u < pc.out_c) acc.z = b_data[pc.b_off + oc0 + 2u];
    if (oc0 + 3u < pc.out_c) acc.w = b_data[pc.b_off + oc0 + 3u];

    uint C = pc.in_c;
    uint C4 = C >> 2;
    uint R = C * pc.kh * pc.kw;
    uint row_v4 = ((R + 3u) & ~3u) >> 2;
    uint wbase = pc.w_off + oc0 * row_v4;
    uint groups = C4 >> 2;
    uint tail = C4 & 3u;

    for (uint kk = 0u; kk < pc.kh * pc.kw; ++kk) {
        uint ky = kk / pc.kw;
        uint kx = kk - ky * pc.kw;
        int ih = int(oh * pc.sh + ky) - int(pc.ph);
        int iw = int(ow * pc.sw + kx) - int(pc.pw);
        if (ih < 0 || ih >= int(pc.in_h) || iw < 0 || iw >= int(pc.in_w)) continue;
        uint ibase = ((uint(ih) * pc.in_w + uint(iw)) * pc.in_ctot + pc.in_off) >> 2;
        uint wrow = wbase + kk * C4;

        for (uint g = 0u; g < groups; ++g) {
            uint o = g * 4u;
            f16vec4 v0 = in4[ibase + o + 0u];
            f16vec4 v1 = in4[ibase + o + 1u];
            f16vec4 v2 = in4[ibase + o + 2u];
            f16vec4 v3 = in4[ibase + o + 3u];
            uint b0 = wrow + o;
            acc.x += float(dot16(v0, v1, v2, v3, w4[b0], w4[b0 + 1u], w4[b0 + 2u], w4[b0 + 3u]));
            uint b1 = b0 + row_v4;
            acc.y += float(dot16(v0, v1, v2, v3, w4[b1], w4[b1 + 1u], w4[b1 + 2u], w4[b1 + 3u]));
            uint b2 = b1 + row_v4;
            acc.z += float(dot16(v0, v1, v2, v3, w4[b2], w4[b2 + 1u], w4[b2 + 2u], w4[b2 + 3u]));
            uint b3 = b2 + row_v4;
            acc.w += float(dot16(v0, v1, v2, v3, w4[b3], w4[b3 + 1u], w4[b3 + 2u], w4[b3 + 3u]));
        }
        for (uint o = groups * 4u; o < C4; ++o) {
            f16vec4 v = in4[ibase + o];
            acc.x += float(dot(v, w4[wrow + o]));
            acc.y += float(dot(v, w4[wrow + o + row_v4]));
            acc.z += float(dot(v, w4[wrow + o + 2u * row_v4]));
            acc.w += float(dot(v, w4[wrow + o + 3u * row_v4]));
        }
    }

    if (pc.silu == 1u) {
        acc = acc / (vec4(1.0) + exp(-acc));
    } else if (pc.silu == 2u) {
        acc = vec4(1.0) / (vec4(1.0) + exp(-acc));
    }
    uint obase = pos * pc.out_ctot + pc.out_off + oc0;
    if ((pc.out_ctot & 3u) == 0u && (pc.out_off & 3u) == 0u && oc0 + 4u <= pc.out_c) {
        out4[obase >> 2] = f16vec4(acc);
    } else {
        for (uint ln = 0u; ln < 4u; ++ln) {
            if (oc0 + ln >= pc.out_c) break;
            o_s[obase + ln] = float16_t(acc[ln]);
        }
    }
}
